# Same-origin in production: the backend serves the React build,
# so API calls use relative /api/... paths. Keep this EMPTY — pointing it at
# another host would send every /api/... call to the wrong server.
VITE_API_BASE_URL=

# Documentation link target. BUILD-TIME only (Vite inlines it during
# `npm run build`); it is NOT read from an App Service App Setting at runtime.
# The PHP docs app serves the file as index.php at its root, so use the root
# URL over https (not /api-docs.php, which does not exist on the deployed app).
VITE_DOCS_URL=https://vt-phpapp-02-due7bkame8hadxeb.australiaeast-01.azurewebsites.net/
