# Same-origin in production: the backend serves the React build,
# so API calls use relative /api/... paths.
VITE_API_BASE_URL=

# Documentation link target. This is a BUILD-TIME variable (Vite inlines it into
# the bundle during `npm run build`) — it is NOT read from an App Service App
# Setting at runtime. The PHP docs app serves the file as index.php at its root,
# so use the root URL (https), not /api-docs.php.
VITE_DOCS_URL=https://vt-phpapp-02-due7bkame8hadxeb.australiaeast-01.azurewebsites.net/
